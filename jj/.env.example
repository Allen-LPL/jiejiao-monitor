# jj 服务密钥模板。复制为 .env 并填入真实值：cp .env.example .env
# .env 已被 .gitignore 忽略，不会入库。config.json 用 ${VAR} 引用这些值。

# 考勤签到接口鉴权(守界者 App 抓包获取的 Bearer JWT)
JJ_AUTH_TOKEN=Bearer <your-jwt-token>
# 考勤请求头里的设备号
JJ_DEVICE_SN=<device-sn>
# 本服务 /api/check 的访问密钥
JJ_API_KEY=<your-api-key>

# 飞书自定义机器人1(webhook + 签名密钥)
FEISHU_BOT1_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/<uuid>
FEISHU_BOT1_SECRET=<sign-secret>
# 飞书自定义机器人2
FEISHU_BOT2_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/<uuid>
FEISHU_BOT2_SECRET=<sign-secret>

# 飞书自建应用(电话加急/图片上传)的 App Secret
FEISHU_APP1_SECRET=<app-secret>
FEISHU_APP2_SECRET=<app-secret>

# 提醒电话号码(本人 / 第二优先级 / 兜底)
FEISHU_NOTIFY_MOBILE=<mobile>
FEISHU_APP2_PHONE_MOBILE=<mobile>
FEISHU_BACKUP_MOBILE=<mobile>

# 钉钉机器人(webhook 含 access_token + 加签密钥)
DINGTALK_WEBHOOK=https://oapi.dingtalk.com/robot/send?access_token=<token>
DINGTALK_SECRET=<sign-secret>
